{
	"info": {
		"_postman_id": "smartstock-cse706-step4-collection",
		"name": "SmartStock - Step 4 Automated Functional Testing (Postman)",
		"description": "Functional API testing suite for Step 4 covering the 4 User Stories:\n- US-01 (SCRUM-22): Add New Product\n- US-02 (SCRUM-23): View Product Inventory\n- US-03 (SCRUM-24): Update Product Details\n- US-04 (SCRUM-25): Delete Product",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://127.0.0.1:5000"
		},
		{
			"key": "created_product_id",
			"value": ""
		}
	],
	"item": [
		{
			"name": "0. Authentication - Admin Login",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Authentication successful with admin privileges\", function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.message).to.eql(\"Authentication successful\");",
							"    pm.expect(jsonData.user.is_admin).to.eql(true);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"admin@smartstock.local\",\n    \"password\": \"Admin123!\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/auth/login",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"auth",
						"login"
					]
				}
			}
		},
		{
			"name": "US-01: Add New Product (SCRUM-22)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201 Created\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test(\"Product created with valid SKU and stock values\", function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.product).to.have.property(\"id\");",
							"    pm.expect(jsonData.product.sku).to.eql(\"KB-RGB-101\");",
							"    pm.expect(jsonData.product.quantity).to.eql(20);",
							"    pm.expect(jsonData.product.selling_price).to.eql(3999);",
							"    pm.expect(jsonData.product.formatted_price).to.include(\"₹\");",
							"    ",
							"    // Save ID for subsequent Update and Delete stories",
							"    pm.collectionVariables.set(\"created_product_id\", jsonData.product.id);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"sku\": \"KB-RGB-101\",\n    \"name\": \"Wireless Mechanical Gaming Keyboard\",\n    \"description\": \"Tactile blue switches, multi-device Bluetooth & 2.4GHz\",\n    \"cost_price\": 2500.00,\n    \"selling_price\": 3999.00,\n    \"quantity\": 20,\n    \"reorder_level\": 5\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/products",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"products"
					]
				}
			}
		},
		{
			"name": "US-02: View Product Inventory (SCRUM-23)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response returns inventory list array with totals\", function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property(\"products\");",
							"    pm.expect(jsonData.products).to.be.an(\"array\");",
							"    pm.expect(jsonData.total).to.be.above(0);",
							"});",
							"",
							"pm.test(\"Inventory items include Indian Rupee formatted prices\", function () {",
							"    const jsonData = pm.response.json();",
							"    const item = jsonData.products[0];",
							"    pm.expect(item).to.have.property(\"formatted_price\");",
							"    pm.expect(item.formatted_price).to.include(\"₹\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/api/products",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"products"
					]
				}
			}
		},
		{
			"name": "US-02b: Retrieve Single Product by ID",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Retrieved product matches requested ID\", function () {",
							"    const jsonData = pm.response.json();",
							"    const expectedId = pm.collectionVariables.get(\"created_product_id\");",
							"    pm.expect(jsonData.id).to.eql(parseInt(expectedId));",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/api/products/{{created_product_id}}",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"products",
						"{{created_product_id}}"
					]
				}
			}
		},
		{
			"name": "US-03: Update Product Details (SCRUM-24)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Product details successfully updated with stock adjustment\", function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.message).to.eql(\"Product updated successfully\");",
							"    pm.expect(jsonData.product.name).to.include(\"RGB Edition V2\");",
							"    pm.expect(jsonData.product.quantity).to.eql(30);",
							"    pm.expect(jsonData.product.selling_price).to.eql(4299);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"name\": \"Wireless Mechanical Gaming Keyboard RGB Edition V2\",\n    \"selling_price\": 4299.00,\n    \"quantity\": 30,\n    \"reorder_level\": 8\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/products/{{created_product_id}}",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"products",
						"{{created_product_id}}"
					]
				}
			}
		},
		{
			"name": "US-04: Delete Product (SCRUM-25)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Product deletion confirmed\", function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.message).to.eql(\"Product deleted successfully\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "DELETE",
				"header": [],
				"url": {
					"raw": "{{base_url}}/api/products/{{created_product_id}}",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"products",
						"{{created_product_id}}"
					]
				}
			}
		},
		{
			"name": "US-04b: Verify Product is Deleted (404)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 404 Not Found after deletion\", function () {",
							"    pm.response.to.have.status(404);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/api/products/{{created_product_id}}",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"products",
						"{{created_product_id}}"
					]
				}
			}
		}
	]
}
